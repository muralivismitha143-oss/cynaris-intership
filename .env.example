# ==============================================================================
# Cynaris Recruitment Platform — Environment Variables Template
# Copy this file to .env for local development:
# cp .env.example .env
#
# IMPORTANT: NEVER commit actual API keys, secrets, or passwords to Git!
# Configure these variables in Railway or Render platform dashboards.
# ==============================================================================

# Server Environment & Port (Assigned automatically by Railway / Render)
PORT=3000
NODE_ENV=production
HOST=0.0.0.0

# AI Provider API Credentials
# Primary Model: llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# Fallback Model: meta-llama/llama-3.3-70b-instruct
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Client Timezone for Date Partitioning
CLIENT_TIMEZONE=Asia/Kolkata
