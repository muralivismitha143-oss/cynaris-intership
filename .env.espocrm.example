# ==============================================================================
# EspoCRM Docker Environment Configuration Template
# ==============================================================================
# Copy this file to .env.espocrm before running docker compose:
#   cp .env.espocrm.example .env.espocrm
# NEVER commit .env.espocrm with real production passwords to version control.
# ==============================================================================

# Application Port Bindings
ESPOCRM_PORT=8080
PMA_PORT=8081

# Public Site URL (Used for API calls, email templates, and asset URLs)
ESPOCRM_SITE_URL=http://localhost:8080

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
ESPOCRM_DATABASE_HOST=espocrm-mysql
ESPOCRM_DATABASE_NAME=espocrm
ESPOCRM_DATABASE_USER=espocrm
ESPOCRM_DATABASE_PASSWORD=your_secure_db_password_here

# Initial Admin Credentials for Auto-Installation
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=your_secure_admin_password_here

# Timezone & Localization
ESPOCRM_TIMEZONE=Asia/Kolkata
ESPOCRM_LANGUAGE=en_US
