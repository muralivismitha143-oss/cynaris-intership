{
  "name": "Job Applicant",
  "doctype": "DocType",
  "module": "Cynaris Recruitment",
  "custom": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "applicant_name",
      "fieldtype": "Data",
      "label": "Applicant Name",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "email_id",
      "fieldtype": "Data",
      "label": "Email Address",
      "options": "Email",
      "in_list_view": 1
    },
    {
      "fieldname": "phone_number",
      "fieldtype": "Data",
      "label": "Phone Number"
    },
    {
      "fieldname": "job_title",
      "fieldtype": "Data",
      "label": "Applied Role / Job Title",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "pipeline_stage",
      "fieldtype": "Select",
      "label": "Pipeline Stage",
      "options": "Screening\nTechnical Round 1\nTechnical Round 2\nHR Round\nOffered\nRejected",
      "default": "Screening",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "experience_years",
      "fieldtype": "Float",
      "label": "Years of Experience",
      "default": 0
    },
    {
      "fieldname": "skills",
      "fieldtype": "Small Text",
      "label": "Key Skills & Technologies"
    },
    {
      "fieldname": "education",
      "fieldtype": "Data",
      "label": "Highest Education"
    },
    {
      "fieldname": "resume_attachment",
      "fieldtype": "Attach",
      "label": "Resume Attachment"
    },
    {
      "fieldname": "resume_text",
      "fieldtype": "Long Text",
      "label": "Extracted Resume Text"
    },
    {
      "fieldname": "ai_section",
      "fieldtype": "Section Break",
      "label": "AI Intelligence & Screening"
    },
    {
      "fieldname": "ai_resume_summary",
      "fieldtype": "Long Text",
      "label": "AI Resume Summary",
      "description": "Auto-generated structured analysis from Groq (Llama 3.3 70B) with OpenRouter fallback",
      "in_list_view": 0,
      "read_only": 0
    },
    {
      "fieldname": "ai_summary_provider",
      "fieldtype": "Data",
      "label": "AI Provider Used",
      "read_only": 1
    },
    {
      "fieldname": "ai_analyzed_at",
      "fieldtype": "Datetime",
      "label": "AI Analyzed At",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Interviewer",
      "read": 1,
      "write": 1,
      "create": 0,
      "delete": 0
    }
  ]
}
