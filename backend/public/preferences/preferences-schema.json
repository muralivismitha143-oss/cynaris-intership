{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CynarisUserPreferences",
  "description": "User Notification and Smart Reminders AI Preference Settings Schema",
  "type": "object",
  "required": ["userId", "channels", "quietHours", "workingSchedule", "remindersPolicy"],
  "properties": {
    "userId": {
      "type": "string",
      "description": "Unique identifier for recruiter or interviewer profile"
    },
    "channels": {
      "type": "object",
      "properties": {
        "email": { "type": "boolean" },
        "whatsapp": { "type": "boolean" },
        "inApp": { "type": "boolean" },
        "sms": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "quietHours": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "start": { "type": "string", "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$" },
        "end": { "type": "string", "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$" }
      },
      "required": ["enabled", "start", "end"]
    },
    "workingSchedule": {
      "type": "object",
      "properties": {
        "days": {
          "type": "array",
          "items": { "type": "string", "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"] }
        },
        "startHour": { "type": "string", "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$" },
        "endHour": { "type": "string", "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$" }
      },
      "required": ["days", "startHour", "endHour"]
    },
    "remindersPolicy": {
      "type": "object",
      "properties": {
        "minimumUrgency": { "type": "string", "enum": ["All", "Medium", "High", "Critical"] },
        "autoScheduleAiSuggestions": { "type": "boolean" },
        "batchDigest": { "type": "boolean" },
        "digestFrequency": { "type": "string" }
      }
    }
  }
}
