# ==============================================================================
# Environment Configuration Template for moodlehq/moodle-docker
# Copy this file to .env before starting Moodle: `cp .env.moodle.example .env`
# ==============================================================================

# Web Server & Port Configuration
MOODLE_DOCKER_WEB_PORT=8000
MOODLE_DOCKER_PHP_VERSION=8.1
MOODLE_DOCKER_WWWROOT=http://localhost:8000
MOODLE_DOCKER_DATAROOT=/var/www/moodledata

# Database Configuration (PostgreSQL / MariaDB / MySQL)
MOODLE_DOCKER_DB=pgsql
MOODLE_DOCKER_DB_HOST=moodle-db
MOODLE_DOCKER_DB_PORT=5432
MOODLE_DOCKER_DB_NAME=moodle
MOODLE_DOCKER_DB_USER=moodle
MOODLE_DOCKER_DB_PASSWORD=moodle_secret_pw

# Administrator Account
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=AdminPassword123!
MOODLE_ADMIN_EMAIL=admin@cynaris.com

# SMTP & Mailhog Test Service
MAILHOG_PORT=8025
