# Application Port Configuration
PORT=3000
REMINDERS_PORT=3005
NODE_ENV=production
CLIENT_TIMEZONE=Asia/Kolkata

# MySQL 8.0 Database Configuration
DB_PORT=3306
DB_NAME=espocrm
DB_USER=espocrm
DB_PASSWORD=espocrm_secret_pw
DB_ROOT_PASSWORD=root_password_change_in_prod

# Authentication & Security
JWT_SECRET=cynaris-production-jwt-token-signing-secret-key-32chars

# AI Intelligence Providers
GROQ_API_KEY=gsk_your_groq_production_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_production_key_here

# Cloud Deployment & Webhooks
DEPLOY_HOOK_URL=https://api.railway.app/deploy/your_webhook_id_here
